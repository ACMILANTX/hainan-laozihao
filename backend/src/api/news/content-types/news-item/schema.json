{
  "kind": "collectionType",
  "collectionName": "news",
  "info": {
    "singularName": "news-item",
    "pluralName": "news",
    "displayName": "News",
    "description": "新闻资讯"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "richtext"
    },
    "coverUrl": {
      "type": "string"
    },
    "publishedAt": {
      "type": "datetime"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "event_updates",
        "policy_digest",
        "association_notice",
        "time_honored_mall"
      ],
      "default": "association_notice"
    },
    "videoUrl": {
      "type": "string"
    },
    "videoCover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
