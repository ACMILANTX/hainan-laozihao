{
  "kind": "collectionType",
  "collectionName": "members",
  "info": {
    "singularName": "member",
    "pluralName": "members",
    "displayName": "Member",
    "description": "协会会员"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "bio": {
      "type": "text"
    },
    "avatarUrl": {
      "type": "string"
    },
    "brandStory": {
      "type": "text"
    },
    "city": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "tagColor": {
      "type": "string"
    },
    "wallOrder": {
      "type": "integer",
      "default": 0
    },
    "province": {
      "type": "string"
    },
    "brandLevel": {
      "type": "enumeration",
      "enum": [
        "中华老字号",
        "海南老字号",
        "海南新字号",
        "品牌培育库"
      ],
      "default": "海南新字号"
    },
    "productIntro": {
      "type": "richtext"
    },
    "productImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "officialWebsite": {
      "type": "string"
    },
    "officialWebsiteLabel": {
      "type": "string"
    }
  }
}
